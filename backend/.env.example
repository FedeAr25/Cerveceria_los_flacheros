# Copiá este archivo a .env y cambiá los valores. El .env NO se sube al repo.
# (El .gitignore ya excluye .env)

# --- Django ---
DJANGO_SECRET_KEY=cambiame-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# Local: SQLite (no requiere instalar nada).
DATABASE_URL=sqlite:///db.sqlite3
# Docker (compose.yaml): PostgreSQL 17. Descomentar esta línea y borrar la de arriba.
# DATABASE_URL=postgres://flacheros:flacheros@db:5432/flacheros

# --- Docker Compose / PostgreSQL ---
POSTGRES_DB=flacheros
POSTGRES_USER=flacheros
POSTGRES_PASSWORD=flacheros

# --- CORS ---
# Origen del frontend (Next.js). Separados por coma si hay más de uno.
CORS_ALLOWED_ORIGINS=http://localhost:3000
